@using EcoLoop.Data
@using EcoLoop.Data.Models
@{
    ViewData["Title"] = "Admin Dashboard";

    var topUsers = ViewBag.TopUsers as List<ApplicationUser>;
    var topStores = ViewBag.TopStores as List<Store>;
    var pendingStores = ViewBag.PendingStores as List<Store>;
}

<div class="container mt-4 admin-dashboard">

    <h2>🛠️ Admin Panel</h2>
    <p class="text-muted">Управление на магазини, потребители и обща статистика.</p>

    <div class="row mt-4">
        <div class="col-md-6">
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-success text-white">
                    Най-активни потребители
                </div>
                <div class="card-body">
                    @if (topUsers != null && topUsers.Any())
                    {
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Потребител</th>
                                    <th>Роля</th>
                                    <th>Добавени</th>
                                    <th>Посетени</th>
                                    <th>Събития</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var u in topUsers)
                                {
                                    <tr>
                                        <td>@u.UserName</td>
                                        <td>@u.UserRole</td>
                                        <td>@u.StoresAdded</td>
                                        <td>@u.StoresVisited</td>
                                        <td>@u.EventsJoined</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted">Няма данни.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-primary text-white">
                    Най-посещавани магазини (по ревюта)
                </div>
                <div class="card-body">
                    @if (topStores != null && topStores.Any())
                    {
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Магазин</th>
                                    <th>Категория</th>
                                    <th>Ревюта</th>
                                    <th>Рейтинг</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in topStores)
                                {
                                    <tr>
                                        <td>@s.Name</td>
                                        <td>@s.Category</td>
                                        <td>@s.Reviews.Count</td>
                                        <td>@s.Rating</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted">Няма данни.</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mt-3">
        <div class="card-header bg-warning">
            Чакащи одобрение магазини
        </div>
        <div class="card-body">
            @if (pendingStores != null && pendingStores.Any())
            {
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Име</th>
                            <th>Категория</th>
                            <th>Адрес</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in pendingStores)
                        {
                            <tr>
                                <td>@s.Name</td>
                                <td>@s.Category</td>
                                <td>@s.Address</td>
                                <td>
                                    <form method="post" asp-action="ApproveStore" asp-route-id="@s.Id">
                                        <button type="submit" class="btn btn-sm btn-success">✅ Одобри</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">Няма чакащи магазини.</p>
            }
        </div>
    </div>

</div>

<style>
    .admin-dashboard h2 {
        margin-bottom: 5px;
    }
</style>
