@model EcoLoop.Models.HomeViewModel

<div class="container mt-5">

    <!-- HERO HEADER -->
    <div class="text-center mb-5">
        <h1 class="hero-title">Открий устойчивото около теб</h1>
        <p class="lead">Намери еко магазини, събития и новини във вашия град</p>
    </div>

    <!-- NEARBY STORES -->
    <h3 class="section-title mb-4">🏪 Близо до теб</h3>

    <div class="row">
        @if (Model.NearbyStores.Any())
        {
            foreach (var s in Model.NearbyStores)
            {
                <div class="col-md-3 mb-4">
                    <div class="card store-card shadow-sm">
                        <img src="@s.ImageUrl" class="card-img-top" alt="@s.Name" />
                        <div class="card-body">
                            <h5 class="card-title">@s.Name</h5>
                            <p class="text-muted">@s.Category</p>
                            <a class="btn btn-outline-success w-100" href="/Store/Details/@s.Id">Виж детайли</a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <p class="text-muted">Няма добавени обекти.</p>
        }
    </div>

    <!-- TOP NEWS -->
    <h3 class="section-title mt-5 mb-4">📰 Топ новини</h3>

    <div class="row">
        <div class="col-md-4"><div class="card shadow-sm p-5 bg-white text-center">Скоро…</div></div>
        <div class="col-md-4"><div class="card shadow-sm p-5 bg-white text-center">Скоро…</div></div>
        <div class="col-md-4"><div class="card shadow-sm p-5 bg-white text-center">Скоро…</div></div>
    </div>

    <!-- EVENTS -->
    <h3 class="section-title mt-5 mb-4">📅 Предстоящи събития</h3>

    <div class="row">
        <div class="col-md-4"><div class="card shadow-sm p-5 bg-white text-center">Скоро…</div></div>
        <div class="col-md-4"><div class="card shadow-sm p-5 bg-white text-center">Скоро…</div></div>
        <div class="col-md-4"><div class="card shadow-sm p-5 bg-white text-center">Скоро…</div></div>
    </div>

    <!-- STATISTICS -->
    <h3 class="section-title mt-5 mb-4">📊 Статистика на общността</h3>

    <div class="row text-center">

        <div class="col-md-4 mb-3">
            <div class="stat-box">
                <h2 class="fw-bold">@Model.StoresCount</h2>
                <p class="text-muted">Еко магазина</p>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="stat-box">
                <h2 class="fw-bold">@Model.ReviewsCount</h2>
                <p class="text-muted">Ревюта</p>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="stat-box">
                <h2 class="fw-bold">@Model.EventsCount</h2>
                <p class="text-muted">Събития</p>
            </div>
        </div>

    </div>


</div>
