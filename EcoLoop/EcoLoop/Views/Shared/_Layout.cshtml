@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EcoLoop</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/EcoLoop.styles.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light navbar-eco-light shadow-sm sticky-top">
        <div class="container">

            <!-- Logo + text -->
            <a class="navbar-brand d-flex align-items-center fw-bold" href="/">
                <img src="~/images/logo-eco.svg" alt="EcoLoop Logo" class="me-2" />
                EcoLoop
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">

                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item"><a class="nav-link" href="/Map">🗺️ Карта</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Events">📅 Събития</a></li>
                    <li class="nav-item"><a class="nav-link" href="/News">📰 Новини</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Store">🛍️ Магазини</a></li>
                </ul>

                <!-- Search -->
                <div class="position-relative me-3" style="width: 250px;">
                    <form method="get" action="/Store/Search"
                          class="d-flex align-items-center nav-search px-3 py-1 shadow-sm">
                        <i class="bi bi-search me-2 text-muted"></i>
                        <input type="text" name="q" class="form-control border-0 bg-transparent" placeholder="Търси..." autocomplete="off" id="navbarSearchInput">
                    </form>

                    <div id="navbarSearchDropdown"
                         class="dropdown-menu w-100 shadow-sm mt-1"
                         style="display:none; max-height:250px; overflow-y:auto;">
                    </div>
                </div>

                <ul class="navbar-nav">
                    <li class="nav-item"><a class="nav-link" href="/Identity/Account/Login">Вход</a></li>
                    <li class="nav-item"><a class="btn btn-success ms-2" href="/Identity/Account/Register">Регистрация</a></li>
                </ul>

            </div>
        </div>
    </nav>


    <div class="container pt-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- FOOTER -->
    <footer class="border-top py-4 mt-5">
        <div class="container text-center">

            <p class="mb-2">© 2025 EcoLoop</p>

            <div class="footer-links">

                <a href="/Home/Privacy" class="mx-2">
                    <i class="bi bi-shield-check me-1"></i>
                    Политика за поверителност
                </a>

                <a href="/Home/About" class="mx-2">
                    <i class="bi bi-info-circle me-1"></i>
                    За нас
                </a>

                <a href="/Home/Contact" class="mx-2">
                    <i class="bi bi-envelope me-1"></i>
                    Контакти
                </a>

            </div>

        </div>
    </footer>


    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Autocomplete Script -->
    <script>
        const input = document.getElementById("navbarSearchInput");
        const dropdown = document.getElementById("navbarSearchDropdown");

        input.addEventListener("input", function () {
            let text = this.value.trim();

            if (text.length < 2) {
                dropdown.style.display = "none";
                return;
            }

            // TEMPORARY EXAMPLE RESULTS
            dropdown.innerHTML = `
                <a class="dropdown-item" href="/Store/Search?q=${text}">
                    Търси "${text}"
                </a>
                <div class="dropdown-divider"></div>
                <a class="dropdown-item" href="#">Bio Market — София</a>
                <a class="dropdown-item" href="#">Green Shop — Пловдив</a>
            `;

            dropdown.style.display = "block";
        });

        document.addEventListener("click", function (e) {
            if (!input.contains(e.target)) {
                dropdown.style.display = "none";
            }
        });
    </script>

    @RenderSection("Scripts", required: false)

</body>
</html>
