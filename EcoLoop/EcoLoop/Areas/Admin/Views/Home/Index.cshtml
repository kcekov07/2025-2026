@model EcoLoop.Models.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container mt-4">
    <h2>🛠 Администраторски панел</h2>
    <p class="text-muted">Обща статистика за системата.</p>

    <div class="row mt-4">
        <div class="col-md-3">
            <div class="card p-3 shadow-sm">
                <h6>Потребители</h6>
                <h2 class="text-primary">@Model.Users</h2>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card p-3 shadow-sm">
                <h6>Магазини</h6>
                <h2 class="text-success">@Model.Stores</h2>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card p-3 shadow-sm">
                <h6>Чакащи одобрение</h6>
                <h2 class="text-warning">@Model.PendingStores</h2>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card p-3 shadow-sm">
                <h6>Ревюта</h6>
                <h2 class="text-danger">@Model.Reviews</h2>
            </div>
        </div>
    </div>

    <hr />

    <h4>Модули</h4>
    <div class="mt-3 d-flex flex-wrap gap-2">
        <a class="btn btn-outline-success" href="/Admin/Stores">Магазини</a>
        <a class="btn btn-outline-primary" href="/Admin/News">Новини</a>
        <a class="btn btn-outline-warning" href="/Admin/Events">Събития</a>
        <a class="btn btn-outline-dark" href="/Admin/Users">Потребители</a>
    </div>
</div>
