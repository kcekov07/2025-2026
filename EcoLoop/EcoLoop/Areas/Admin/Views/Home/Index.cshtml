@model EcoLoop.Models.AdminDashboardViewModel

<h2 class="mb-4">Администраторски панел</h2>

<div class="row">

    <div class="col-md-3">
        <div class="card p-3 shadow-sm">
            <h5>Потребители</h5>
            <h2 class="text-primary">@Model.Users</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-3 shadow-sm">
            <h5>Магазини</h5>
            <h2 class="text-success">@Model.Stores</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-3 shadow-sm">
            <h5>Чакащи одобрение</h5>
            <h2 class="text-warning">@Model.PendingStores</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-3 shadow-sm">
            <h5>Ревюта</h5>
            <h2 class="text-danger">@Model.Reviews</h2>
        </div>
    </div>

</div>

<hr />

<div class="mt-4">
    <a class="btn btn-outline-success" href="/Admin/Stores">Управление на магазини</a>
    <a class="btn btn-outline-primary" href="/Admin/News">Управление на новини</a>
    <a class="btn btn-outline-warning" href="/Admin/Events">Управление на събития</a>
    <a class="btn btn-outline-dark" href="/Admin/Users">Управление на потребители</a>
</div>
