@model EcoLoop.Models.AdminUserEditViewModel

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Редакция на роля";
}

<h3 class="mb-3">✏️ Редакция на роля</h3>

<div class="card p-4 shadow-sm">

    <form asp-area="Admin" asp-controller="AdminUsers" asp-action="Edit" method="post">
        @Html.AntiForgeryToken()

        <!-- Hidden ID -->
        <input type="hidden" asp-for="UserId" />

        <div class="mb-3">
            <label class="form-label">Потребител</label>
            <input type="text" value="@Model.UserName" class="form-control" disabled />
        </div>

        <div class="mb-3">
            <label class="form-label">Имейл</label>
            <input type="text" value="@Model.Email" class="form-control" disabled />
        </div>

        <div class="mb-3">
            <label class="form-label">Текуща роля</label>
            <input type="text" value="@Model.CurrentRole" class="form-control" disabled />
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Нова роля</label>
            <select asp-for="NewRole" class="form-select">
                <option value="User">User</option>
                <option value="Producer">Producer</option>
                <option value="Admin">Admin</option>
            </select>

        </div>

        <button class="btn btn-success">💾 Запази</button>
        <a href="/Admin/AdminUsers" class="btn btn-secondary ms-2">Назад</a>

    </form>

</div>
