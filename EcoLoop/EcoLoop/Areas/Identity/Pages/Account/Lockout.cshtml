@page
@model Microsoft.AspNetCore.Identity.UI.V5.Pages.Account.Internal.LockoutModel
@{
    ViewData["Title"] = "Акаунтът е блокиран";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow-sm">
                <div class="card-body text-center">

                    <h2 class="text-danger mb-3">🚫 Акаунтът е блокиран</h2>

                    <p class="mb-3">
                        Вашият акаунт е временно блокиран от администратор.
                    </p>

                    <p class="text-muted">
                        Ако смятате, че това е грешка, свържете се с поддръжката
                        или с администратора на EcoLoop.
                    </p>

                    <a href="/" class="btn btn-success mt-3">
                        ⬅ Към началната страница
                    </a>

                </div>
            </div>

        </div>
    </div>
</div>
